# Copy to .env and fill in. .env is gitignored.
# Loaded automatically by scripts/tts_synthesize.py and scripts/fetch_signals.py
# from the repo root.

# OpenAI — used by /podcast for text-to-speech (gpt-4o-mini-tts).
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# SEC EDGAR contact email — SEC requires a contact address in the User-Agent of
# EDGAR requests (scripts/fetch_signals.py, scripts/fetch_ticker_stats.py, and the
# researcher's curl examples). Use your own email. Falls back to a generic
# placeholder if unset, but setting it is polite and avoids rate-limit issues.
EDGAR_CONTACT_EMAIL=you@example.com

# X — used by /scout to pull recent posts from your curated follow list
# (.claude/scout-x-feeds.json) as a signal source. App-only Bearer Token from a
# project with user-timeline read access (GET /2/users/:id/tweets).
# If unset, /scout simply skips the X source and runs on GDELT/HN/EDGAR as before.
# Get one at https://developer.x.com → Projects & Apps → Keys and tokens.
X_BEARER_TOKEN=

# SnapTrade — used by /sync-portfolio to read your real brokerage state (accounts,
# balances, positions, recent activity). These are *Personal* API key credentials:
# they represent you directly (no userId/userSecret) and requests are HMAC-signed
# locally with the consumerKey. Treat the consumerKey as highly sensitive — it has
# full read access to every brokerage connected to your SnapTrade account.
# 1. Create a SnapTrade account and a Personal API key at https://dashboard.snaptrade.com
# 2. Connect your brokerage once via the Connection Portal (browser, one-time)
# 3. Paste clientId + consumerKey below
# If unset, /sync-portfolio degrades to a review-only pass over the last committed
# tracking/brokerage-snapshot.json.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
